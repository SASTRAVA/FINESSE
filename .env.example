# ============================================================
#  SASTRAVA FINESSE — environment
#  Copy to  .env  and fill in.  NEVER commit the real .env.
#  (The old Brain app.py leaked a Groq key in plaintext — don't repeat that.)
# ============================================================

# ---------- APP BINDING ----------
FINESSE_ENV=development
HOST=127.0.0.1
PORT=8600
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_PROXY_IPS=
ALLOW_UNENCRYPTED_PUBLIC_BIND=false
REDIS_URL=
DATABASE_URL=
KMS_MASTER_KEY=<GENERATE_A_RANDOM_32_BYTE_OR_LONGER_KEY>
SALES_DRY_RUN=true
SALES_LIVE_OUTREACH_ENABLED=false
EMAIL_PROVIDER=sandbox
EMAIL_LIVE_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
PUBLIC_BASE_URL=http://localhost:8600
# Default-tenant webhook key only; set per-tenant signing keys via the admin API.
WEBHOOK_SIGNING_SECRET=<GENERATE_A_RANDOM_WEBHOOK_SECRET>
VOICE_PROVIDER=sandbox
VOICE_LIVE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
VOICE_WEBHOOK_URL=
SALES_ENRICHMENT_ENABLED=false
ENRICHMENT_PROVIDER_URL=
ENRICHMENT_API_TOKEN=
CALENDAR_PROVIDER=local
CALENDAR_SYNC_ENABLED=false
CALENDAR_WEBHOOK_URL=
CALENDAR_API_TOKEN=
POSTGRES_PASSWORD=<SET_A_UNIQUE_DATABASE_PASSWORD>
# Optional runtime state path; defaults to ./data.
# FINESSE_DATA_DIR=./data
# Compatibility names; HOST / PORT take precedence.
APP_HOST=127.0.0.1
APP_PORT=8600
REDACT_PII_ON_EXTERNAL_LLM=true
ALLOW_CONFIDENTIAL_EXTERNAL_EGRESS=false

# ---------- INFERENCE : NVIDIA NIM (free tier) ----------
# Get a free key at https://build.nvidia.com  ->  "Get API Key"
NVIDIA_API_KEY=<PASTE_YOUR_FREE_NIM_KEY_HERE>
# Optional 2nd free NIM key dedicated to JARVIS so his voice replies never queue behind
# the agent swarm (snappier). Put a stronger model here for wittier replies.
NVIDIA_API_KEY_JARVIS=
NIM_MODEL_JARVIS=meta/llama-3.1-70b-instruct
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# GROQ = the real fix for a SNAPPY JARVIS (free, sub-second). Get a key: https://console.groq.com/keys
# When set, JARVIS's voice brain uses Groq (instant) instead of the slow free NIM tier.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
JARVIS_TIMEOUT_S=15

# ---------- PER-LANE NIM KEYS (kill the swarm bottleneck) ----------
# Give each agent lane its OWN free NIM key so lanes never fight one key's rate limit.
# Empty = that lane falls back to NVIDIA_API_KEY. Monitor at GET /api/keys.
NIM_KEY_CODING=
NIM_KEY_PROMPT=
NIM_KEY_MARKETING=
NIM_KEY_BIZDEV=
NIM_KEY_EXEC=
NIM_KEY_GENERAL=
NIM_KEY_SECURITY=
LANE_CONCURRENCY=4

# Model routing (all free on build.nvidia.com). Change per-agent in engine/config.py.
NIM_MODEL_ORCHESTRATOR=qwen/qwen3-next-80b-a3b-instruct
NIM_MODEL_CODING=qwen/qwen3-next-80b-a3b-instruct
NIM_MODEL_PROMPT=meta/llama-3.1-70b-instruct
NIM_MODEL_MARKETING=meta/llama-3.1-70b-instruct
NIM_MODEL_FAST=meta/llama-3.1-8b-instruct

# ---------- LOCAL GPU (leave blank until you attach a GPU) ----------
# When set, the provider auto-switches heavy calls to your local quantized server.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=

# ---------- EMBEDDINGS ----------
# local  = fastembed INT8-quantized BGE (CPU, free, no key)   [recommended now]
# nim    = NVIDIA hosted embeddings (needs NVIDIA_API_KEY)
EMBEDDINGS_BACKEND=local
EMBEDDINGS_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBEDDINGS_MODEL_NIM=nvidia/nv-embedqa-e5-v5

# ---------- VECTOR DB (Qdrant) ----------
# embedded = on-disk local (no server)   |   server = point at a running Qdrant
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=sastrava_brain

# ---------- AUTH ----------
# generate:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=<GENERATE_A_RANDOM_64_CHAR_HEX_SECRET>
JWT_EXPIRY_HOURS=12
# CEO bootstrap admin (you). Change the password on first login.
CEO_EMAIL=ceo@example.com
CEO_PASSWORD=<SET_A_STRONG_CEO_PASSWORD>

# ---------- VAULT / OBSIDIAN ----------
VAULT_PATH=./vault
# Optional: Obsidian Local REST API plugin (only if you want push updates into a running Obsidian)
OBSIDIAN_REST_URL=
OBSIDIAN_API_KEY=

# ---------- JARVIS PREMIUM VOICE (add ONE key -> natural voice instead of robotic browser TTS) ----------
# OpenAI: deep male "onyx"/"ash".  Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=onyx
# ElevenLabs: the most JARVIS-like. Key: https://elevenlabs.io  (voice id = a British male, e.g. "Daniel")
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_MODEL=eleven_turbo_v2_5
# brain tier for JARVIS's spoken replies: fast (snappy) | orchestrator (smarter, slower)
JARVIS_MODEL_ROLE=fast

# ---------- CONTINUOUS GROWTH (opt-in — off by default) ----------
# The brain keeps growing while humans stay on client outreach.
CRAWLER_ENABLED=0
CRAWLER_INTERVAL_MIN=30
CRAWLER_QUERIES=            # comma-separated, e.g. "edtech startups India, ai course demand"
CRAWLER_LEADGEN=0          # 1 = also auto-generate leads into the CRM each cycle
CRAWLER_ICP=small businesses needing digital marketing
CRAWLER_LOCATION=          # geo, e.g. "Bangalore, India"
REWEAVE_INTERVAL_MIN=0     # 0=off; e.g. 60 = re-connect the graph every hour

# ---------- SKILL HARVESTING from free GitHub repos (opt-in) ----------
# Continuously pulls .md skills/prompts into the brain to raise accuracy.
SKILL_HARVEST_ENABLED=0
SKILL_HARVEST_INTERVAL_MIN=360
# comma list of "owner/repo" or "owner/repo/sub/path"
SKILL_REPOS=

# ---------- SECURITY AUDIT AGENT (continuous, opt-in) ----------
# A paranoid OWASP-style agent that audits the live platform on a timer (RBAC,
# secret exposure, write-gating, audit anomalies, weak config), writes reports to
# vault/22_Security, and alerts on low posture. On first run it harvests baseline
# security skills into the brain so it's trained from day one.
SECURITY_AUDIT_ENABLED=0
SECURITY_AUDIT_INTERVAL_MIN=180
SECURITY_HARVEST_REPOS=OWASP/CheatSheetSeries/cheatsheets, swisskyrepo/PayloadsAllTheThings

# ---------- CONCURRENCY / turboquant knobs ----------
MAX_CONCURRENT_LLM=8          # global in-flight LLM calls (protects free-tier limits)
SWARM_MAX_AGENTS=64           # hard cap on simultaneously-live agents
LLM_CACHE_SIZE=512            # semantic response cache entries
REQUEST_TIMEOUT_S=90

# ---------- OPTIONAL MCP CONNECTORS (turn on only what you use) ----------
GITHUB_TOKEN=
GMAIL_CREDENTIALS_JSON=
GOOGLE_DRIVE_CREDENTIALS_JSON=
SLACK_BOT_TOKEN=
