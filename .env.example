# Local FINESSE runtime
FINESSE_ENV=development
HOST=127.0.0.1
PORT=8600
CORS_ORIGINS=http://localhost:8600,http://127.0.0.1:8600
FINESSE_DATA_DIR=data
VAULT_PATH=vault

# Required to start the authenticated API. Replace every placeholder locally.
# Use a random JWT secret and KMS key of at least 32 characters each.
JWT_SECRET=set_a_strong_random_secret_at_least_32_characters
CEO_EMAIL=ceo@example.com
CEO_PASSWORD=set_a_strong_unique_password_at_least_12_characters
KMS_MASTER_KEY=set_a_strong_random_key_at_least_32_characters

# Persistence / retrieval. PostgreSQL and Redis are optional for local smoke
# tests; SQLite and in-process throttling are used when unset.
DATABASE_URL=
REDIS_URL=
QDRANT_MODE=embedded
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=sastrava_brain
EMBEDDINGS_BACKEND=local
EMBEDDINGS_MODEL_LOCAL=BAAI/bge-small-en-v1.5

# LLM provider. Leave empty for offline / mock-safe workflows.
NVIDIA_API_KEY=
NVIDIA_API_KEY_JARVIS=
GROQ_API_KEY=
OPENAI_API_KEY=

# External actions are sandboxed by default. Enable only after configuring
# provider credentials, tenant consent, and explicit human authorization.
SALES_DRY_RUN=true
SALES_LIVE_OUTREACH_ENABLED=false
EMAIL_PROVIDER=sandbox
EMAIL_LIVE_ENABLED=false
VOICE_PROVIDER=sandbox
VOICE_LIVE_ENABLED=false
SALES_ENRICHMENT_ENABLED=false
CALENDAR_SYNC_ENABLED=false
ALLOW_CONFIDENTIAL_EXTERNAL_EGRESS=false
REDACT_PII_ON_EXTERNAL_LLM=true

# Optional integrations
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
OBSIDIAN_REST_URL=
OBSIDIAN_API_KEY=
CRAWLER_ENABLED=0
