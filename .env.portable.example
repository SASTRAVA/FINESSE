# Copy to .env.portable and fill the required blank values before starting.
# Generate JWT_SECRET and KMS_MASTER_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
KMS_MASTER_KEY=
CEO_EMAIL=
CEO_PASSWORD=
PORTABLE_LICENSE_REQUIRED=false
PORTABLE_LICENSE_PUBLIC_KEY=
PORTABLE_TENANT_ID=default
FINESSE_PORT=8600
LOCAL_LLM_MODEL=llama3.2:3b
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
